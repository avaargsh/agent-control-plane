{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/schemas/agent-release.schema.json",
  "title":"AgentRelease",
  "type":"object",
  "additionalProperties":false,
  "required":["apiVersion","kind","metadata","spec"],
  "properties":{
    "apiVersion":{"const":"agentplane.io/v1alpha1"},
    "kind":{"const":"AgentRelease"},
    "metadata":{"type":"object","required":["name"],"properties":{"name":{"type":"string"}},"additionalProperties":false},
    "spec":{"type":"object","additionalProperties":false,"required":["bundleRef","bindings"],"properties":{
      "bundleRef":{"type":"string"},
      "version":{"type":"string"},
      "bindings":{"type":"array","items":{"type":"string"},"uniqueItems":true},
      "placement":{"type":"object","additionalProperties":true},
      "policyRefs":{"type":"array","items":{"type":"string"},"uniqueItems":true},
      "capabilityIntentRefs":{"type":"array","items":{"type":"string","minLength":1},"uniqueItems":true},
      "evidenceRequirements":{"type":"object","additionalProperties":false,"properties":{
        "requireExternalCollector":{"type":"boolean","default":true},
        "minimumIndependentObservers":{"type":"integer","minimum":1,"default":1},
        "requiredProvenanceFields":{"type":"array","items":{"enum":["generated_by","observed_by","authorized_by","executed_by","committed_by"]},"uniqueItems":true}
      }},
      "evalGates":{"type":"array","items":{"type":"string"},"uniqueItems":true},
      "rollout":{"type":"object","additionalProperties":true},
      "authorityRef":{"type":"string","minLength":1},
      "authorityDigest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}
    },"dependentRequired":{"authorityRef":["authorityDigest"],"authorityDigest":["authorityRef"]}}
  }
}
