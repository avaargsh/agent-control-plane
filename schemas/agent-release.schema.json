      ],
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "bundleRef",
        "bindings"
      ],
      "properties": {
        "bundleRef": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "bindings": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "placement": {
          "type": "object",
          "additionalProperties": true
        },
        "policyRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evalGates": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "rollout": {
          "type": "object",
          "additionalProperties": true
        }
      }
    }
  }
}
