{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentplane.io/v1alpha1"
    },
    "kind": {
      "const": "Run"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionRef",
        "releaseRef",
        "status"
      ],
      "properties": {
        "sessionRef": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "created",
            "running",
            "paused",
            "succeeded",
            "failed",
            "cancelled"
          ]
        },
        "providerRefs": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "artifactRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "evidenceRefs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "releaseRef": {
          "type": "string",
          "minLength": 1
        },
        "workflowRef": {
          "type": "string",
          "minLength": 1
        },
        "sandboxRef": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
