{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "EvalGate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentplane.io/v1alpha1"
    },
    "kind": {
      "const": "EvalGate"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "suiteRef",
        "conditions"
      ],
      "properties": {
        "suiteRef": {
          "type": "string",
          "minLength": 1
        },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "metric",
              "op",
              "value"
            ],
            "properties": {
              "metric": {
                "type": "string",
                "minLength": 1
              },
              "op": {
                "enum": [
                  "lt",
                  "lte",
                  "gt",
                  "gte",
                  "eq"
                ]
              },
              "value": {
                "type": "number"
              }
            }
          }
        },
        "evidenceRequired": {
          "type": "boolean",
          "default": true
        },
        "onFailure": {
          "enum": [
            "block",
            "rollback",
            "manual-review"
          ],
          "default": "block"
        },
        "requiredProvenance": {
          "type": "array",
          "items": {
            "enum": [
              "operation"
            ]
          },
          "uniqueItems": true,
          "default": []
        }
      }
    }
  }
}
