{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/runtime-binding.schema.json",
  "title": "RuntimeBinding",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "metadata", "spec"],
  "properties": {
    "apiVersion": {"const": "agentplane.io/v1alpha1"},
    "kind": {"const": "RuntimeBinding"},
    "metadata": {
      "type": "object",
      "required": ["name"],
      "properties": {"name": {"type": "string", "minLength": 1}},
      "additionalProperties": false
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "provider"],
      "properties": {
        "type": {
          "enum": [
            "harness", "workflow", "context", "memory", "sandbox",
            "tool", "traffic", "model", "decision", "agent"
          ]
        },
        "provider": {"type": "string", "minLength": 1},
        "endpointRef": {"type": "string"},
        "dependsOn": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "ownership": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "execution": {"enum": ["caller", "provider", "target", "distributed"]},
            "continuation": {"enum": ["caller", "provider", "target", "distributed"]},
            "context": {"enum": ["caller", "provider", "target", "shared", "projected"]}
          }
        },
        "config": {"type": "object", "additionalProperties": true},
        "secretRefs": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        }
      }
    }
  }
}
