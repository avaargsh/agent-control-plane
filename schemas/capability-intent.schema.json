{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://example.invalid/schemas/capability-intent.schema.json",
  "title":"CapabilityIntent",
  "type":"object",
  "additionalProperties":false,
  "required":["apiVersion","kind","metadata","spec"],
  "properties":{
    "apiVersion":{"const":"agentplane.io/v1alpha1"},
    "kind":{"const":"CapabilityIntent"},
    "metadata":{"type":"object","additionalProperties":false,"required":["name"],"properties":{"name":{"type":"string","minLength":1}}},
    "spec":{"type":"object","additionalProperties":false,"required":["capabilities"],"properties":{
      "defaultDeny":{"type":"boolean","default":true},
      "capabilities":{"type":"array","minItems":1,"items":{"type":"object","additionalProperties":false,"required":["name"],"properties":{
        "name":{"type":"string","minLength":1},
        "effect":{"enum":["allow","deny"],"default":"allow"},
        "constraints":{"type":"object","additionalProperties":true}
      }}},
      "credentialLeases":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["ref","ttlSeconds"],"properties":{
        "ref":{"type":"string","minLength":1},
        "ttlSeconds":{"type":"integer","minimum":1}
      }}}
    }}
  }
}
