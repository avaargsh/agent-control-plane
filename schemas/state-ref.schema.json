{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "StateRef",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "properties": {
    "apiVersion": {
      "const": "agentplane.io/v1alpha1"
    },
    "kind": {
      "const": "StateRef"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "uri"
      ],
      "properties": {
        "type": {
          "enum": [
            "transactional",
            "artifact",
            "memory",
            "workflow",
            "sandbox",
            "provider"
          ]
        },
        "uri": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": "string"
        },
        "immutable": {
          "type": "boolean",
          "default": false
        },
        "checksum": {
          "type": "string"
        }
      }
    }
  }
}
