    "react-native-safe-area-context": "~5.7.0",
    "@noble/hashes": "2.0.1",
    "expo-document-picker": "~57.0.3",
    "expo-file-system": "~57.0.7",
    "expo-sharing": "~57.0.19"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3",
