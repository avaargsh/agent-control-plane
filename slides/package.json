{
  "name": "agentledger-slides",
  "private": true,
  "scripts": {
    "dev": "slidev --open",
    "build": "slidev build",
    "export": "slidev export",
    "serve": "npx serve dist",
    "dev:judge": "slidev judge.md --open",
    "build:judge": "slidev build judge.md --out dist-judge --base /dist-judge/",
    "dev:judge:en": "slidev judge.en.md --open",
    "build:judge:en": "slidev build judge.en.md --out dist-judge-en --base /dist-judge-en/",
    "export:judge:pdf": "slidev export judge.md --format pdf --output AgentLedger-Judge-Pitch.pdf",
    "export:judge:pptx": "slidev export judge.md --format pptx --output AgentLedger-Judge-Pitch.pptx"
  },
  "devDependencies": {
    "@slidev/cli": "^53.0.0",
    "@slidev/theme-default": "^0.25.0",
    "serve": "^14.2.3"
  }
}
